// xcconfig treats `//` as a comment start — the `$()` empty substitution
// below keeps the URL slashes intact. Copy this file to Secrets.Debug.xcconfig
// and Secrets.Release.xcconfig, then fill in your RapidAPI values.
API_KEY = your_api_key
API_HOST = api.example.com
BASE_URL = https:/$()/api.example.com/v1
